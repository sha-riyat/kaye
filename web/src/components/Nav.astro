---
/** Top navigation. `tone` follows the band it sits on; `floating` draws it as a pill (cream heroes). */
import lockupCauri from "../assets/brand/lockup-cauri.svg";
import lockupNight from "../assets/brand/lockup-night.svg";
import { WHATSAPP } from "../site";

interface Props {
  tone?: "nuit" | "cauri";
  floating?: boolean;
}
const { tone = "nuit", floating = false } = Astro.props;
const lockup = tone === "nuit" ? lockupCauri : lockupNight;
---

<nav
  aria-label="Navigation principale"
  class:list={[
    "flex items-center justify-between gap-4",
    floating
      ? "mx-auto max-w-[1120px] rounded-full bg-papier py-2.5 pr-2.5 pl-6 shadow-[0_1px_0_rgba(20,17,27,.06),0_12px_30px_rgba(20,17,27,.08)]"
      : "mx-auto max-w-[1200px] px-6 py-5",
  ]}
>
  <a href="/" aria-label="Kayé, accueil" class="shrink-0">
    <img src={lockup.src} alt="Kayé" width="118" height="40" class="block h-8 w-auto @3xl:h-9" />
  </a>
  <div class:list={["hidden items-center gap-7 text-[15px] font-medium @3xl:flex", tone === "nuit" ? "text-cauri" : "text-nuit"]}>
    <a href="#comment" class="no-underline hover:text-solaire" style="color:inherit">Comment ça marche</a>
    <a href="#documents" class="no-underline hover:text-solaire" style="color:inherit">Les documents</a>
    <a href="/confidentialite" class="no-underline hover:text-solaire" style="color:inherit">Confidentialité</a>
  </div>
  <a href={WHATSAPP} class="btn btn-sun min-h-11 px-5 text-[15px]">Écrire à Kayé</a>
</nav>
