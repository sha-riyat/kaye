---
/** Top navigation. It keeps its place in the page at rest; once the page scrolls, it detaches into a
 * blurred pill that stays at the top, so the sections and « Écrire à Kayé » are always one tap away.
 * `half` keeps it on the left half of a split cover while at rest. */
import lockupCauri from "../assets/brand/lockup-cauri.svg";
import { copy, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
  half?: boolean;
}
const { lang = "fr", half = false } = Astro.props;
const t = copy[lang];
const links = [
  { href: `${t.home}#comment`, label: t.nav.how },
  { href: `${t.home}#promesse`, label: t.nav.promise },
  { href: t.privacy, label: t.nav.privacy },
];
---

<div class="h-[88px]">
  <div class="nav-bar fixed inset-x-0 top-0 z-50" data-nav>
    <nav
      aria-label={t.nav.label}
      class:list={["nav-inner mx-auto flex max-w-[1280px] items-center justify-between gap-4 px-6 py-6 @5xl:px-10", half && "@5xl:ml-0 @5xl:max-w-[56%]"]}
    >
      <a href={t.home} aria-label={t.nav.home} class="shrink-0"><img src={lockupCauri.src} alt="Kayé" width="120" height="40" class="block h-8 w-auto" /></a>
      <ul class="m-0 hidden list-none items-center gap-6 p-0 text-[15px] font-medium whitespace-nowrap text-cauri @4xl:flex">
        {links.map((l) => <li><a href={l.href} class="text-current no-underline opacity-85 hover:opacity-100">{l.label}</a></li>)}
        <li><a href={t.other.href} lang={lang === "fr" ? "en" : "fr"} class="text-current no-underline opacity-85 hover:opacity-100">{lang === "fr" ? "EN" : "FR"}</a></li>
      </ul>
      <a href={t.wa} class="btn btn-sun min-h-11 shrink-0 px-5 text-[15px] whitespace-nowrap">{t.nav.write}</a>
    </nav>
  </div>
</div>

<style>
  .nav-bar { transition: padding 260ms var(--ease-out); }
  .nav-inner { transition: background-color 260ms var(--ease-out), box-shadow 260ms var(--ease-out); }
  .nav-bar[data-stuck] { padding: 12px 16px 0; }
  .nav-bar[data-stuck] .nav-inner {
    max-width: 1120px;
    margin-inline: auto;
    padding: 8px 8px 8px 22px;
    border-radius: 9999px;
    background: rgb(20 17 27 / 0.74);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    box-shadow: 0 12px 34px rgb(0 0 0 / 0.28), inset 0 0 0 1px rgb(245 233 214 / 0.09);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-bar, .nav-inner { transition: none; }
  }
</style>

<script>
  // In-page links land below the floating bar, not under it.
  document.documentElement.style.scrollPaddingTop = "96px";
  document.querySelectorAll<HTMLElement>("[data-nav]").forEach((bar) => {
    const update = () => bar.toggleAttribute("data-stuck", window.scrollY > 40);
    addEventListener("scroll", update, { passive: true });
    update();
  });
</script>
