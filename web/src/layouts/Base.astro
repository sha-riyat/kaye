---
/** The page shell: language, metadata, fonts and brand tokens. The body is one size container,
 * so sections lay out the same way here and in the design canvas frames. */
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "fr" | "en";
  /** The same page in the other language, for hreflang. */
  alternate?: string;
}
const { title, description, lang = "fr", alternate } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14111B" />
    <link rel="canonical" href={canonical} />
    {alternate && <link rel="alternate" hreflang={lang === "fr" ? "en" : "fr"} href={new URL(alternate, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-640.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="@container">
      <slot />
    </div>
  </body>
</html>
