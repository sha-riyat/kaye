---
/** Hero A · « Comptoir » : the night band of the brand book's landing, with the photo of a
 * shopkeeper on his phone and the conversation playing over it. */
import { Image } from "astro:assets";
import Nav from "../../components/Nav.astro";
import ChatDemo from "../../components/ChatDemo.astro";
import photo from "../../assets/photos/commercant-telephone.jpg";
import { WHATSAPP } from "../../site";
---

<section class="relative overflow-hidden bg-nuit text-cauri">
  <Nav tone="nuit" />
  <div class="mx-auto grid max-w-[1200px] gap-12 px-6 pt-10 pb-24 @5xl:grid-cols-[1.05fr_1fr] @5xl:items-center @5xl:gap-10 @5xl:pt-16 @5xl:pb-32">
    <div class="flex flex-col gap-7">
      <span class="eyebrow text-gris-clair">Pour les commerçants d'Afrique de l'Ouest</span>
      <h1 class="display m-0 text-[clamp(3.1rem,8.2cqi,6.4rem)]">
        Toute votre boutique, <span class="text-solaire">dans WhatsApp.</span>
      </h1>
      <p class="m-0 max-w-[34rem] text-[1.1875rem] leading-relaxed text-lilas @3xl:text-[1.3125rem]">
        Ventes, crédits, stock, dépenses, fournisseurs : dites-le à Kayé comme à un proche. Il tient les
        comptes, envoie les reçus et vous dit chaque soir où en est la boutique.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href={WHATSAPP} class="btn btn-sun">Commencer sur WhatsApp</a>
        <a href="#comment" class="btn btn-ghost text-cauri">Voir comment</a>
      </div>
      <ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-2 p-0 text-[15px] text-gris-clair">
        <li>Rien à installer</li><li>Marche sur un petit téléphone</li><li>Rien n'est noté sans votre « Oui »</li>
      </ul>
    </div>

    <div class="relative mx-auto h-[560px] w-full max-w-[560px] @5xl:h-[640px]">
      <div class="absolute top-0 right-0 h-[80%] w-[74%] overflow-hidden rounded-[36px] @5xl:h-[86%] @5xl:w-[80%]">
        <Image src={photo} alt="Un commerçant en tablier consulte son téléphone dans sa boutique" widths={[480, 720, 960]} sizes="(min-width: 1024px) 460px, 74vw" class="h-full w-full object-cover" loading="eager" />
      </div>
      <div class="absolute bottom-0 left-0 z-10 @5xl:left-[-4%]">
        <ChatDemo width={248} />
      </div>
      <span class="k-pop absolute top-[12%] right-[-2%] z-10 rounded-full bg-lagune px-4 py-2 text-[15px] font-semibold text-papier shadow-lift" style="animation-delay:600ms">Payé 25 000</span>
      <span class="k-pop absolute top-[30%] right-[6%] z-10 rounded-full bg-laterite px-4 py-2 text-[15px] font-semibold text-papier shadow-lift" style="animation-delay:900ms">Reste dû 8 000</span>
    </div>
  </div>
  <div class="kente absolute inset-x-0 bottom-0 h-[22px]" aria-hidden="true"></div>
</section>
