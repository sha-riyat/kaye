---
/** Hero B · « Cauri » : a cream editorial page, the tagline centred and underlined in Solaire,
 * merchants in round frames with coloured halos around it (after August Health), the
 * conversation rising from the bottom between two tickets. */
import { Image } from "astro:assets";
import Nav from "../../components/Nav.astro";
import ChatDemo from "../../components/ChatDemo.astro";
import vendeuse from "../../assets/photos/vendeuse-fruits.jpg";
import tailleur from "../../assets/photos/tailleur.jpg";
import epicier from "../../assets/photos/commercant-sourire.jpg";
import commercante from "../../assets/photos/commercante-comptoir.jpg";
import cauri from "../../assets/brand/symbol-solaire.svg";
import bilan from "../../assets/tickets/bilan.png";
import recu from "../../assets/tickets/recu.png";
import { WHATSAPP } from "../../site";

const portraits = [
  { src: vendeuse, alt: "Une jeune vendeuse de fruits", halo: "bg-solaire", pos: "left-[3%] top-[6%]", size: "w-[150px]" },
  { src: tailleur, alt: "Un tailleur à sa machine", halo: "bg-lagune", pos: "left-[9%] top-[46%]", size: "w-[118px]" },
  { src: epicier, alt: "Un commerçant souriant à son comptoir", halo: "bg-laterite", pos: "right-[4%] top-[4%]", size: "w-[132px]" },
  { src: commercante, alt: "Une commerçante au comptoir", halo: "bg-nuit", pos: "right-[10%] top-[44%]", size: "w-[160px]" },
];
---

<section class="relative overflow-hidden bg-cauri pt-5 text-nuit">
  <div class="px-4"><Nav tone="cauri" floating /></div>

  <div class="relative mx-auto max-w-[1280px] px-6">
    {portraits.map((p, i) => (
      <figure class:list={["k-pop absolute m-0 hidden @5xl:block", p.pos, p.size]} style={`animation-delay:${200 + i * 140}ms`}>
        <span class:list={["absolute inset-[-14px] rounded-full", p.halo]} aria-hidden="true"></span>
        <Image src={p.src} alt={p.alt} widths={[240, 320]} sizes="160px" class="relative aspect-square w-full rounded-full object-cover" />
      </figure>
    ))}
    <img src={cauri.src} alt="" class="k-float absolute top-[30%] left-[24%] hidden w-9 rotate-[-18deg] @5xl:block" aria-hidden="true" />
    <img src={cauri.src} alt="" class="k-float absolute top-[18%] right-[24%] hidden w-7 rotate-[24deg] @5xl:block" style="animation-delay:1.6s" aria-hidden="true" />

    <div class="relative z-10 mx-auto flex max-w-[780px] flex-col items-center gap-7 pt-16 text-center @5xl:pt-24">
      <span class="inline-flex items-center gap-2 rounded-full bg-papier px-4 py-2 text-[14px] font-semibold shadow-[0_1px_0_rgba(20,17,27,.06)]">
        <span class="k-ring inline-block h-2 w-2 rounded-full bg-lagune text-lagune"></span>
        Le cahier de la boutique, dans WhatsApp
      </span>
      <h1 class="display m-0 text-[clamp(3.4rem,9.6cqi,7.6rem)]">
        Parlez.<br /><span class="marker">Kayé note.</span>
      </h1>
      <p class="m-0 max-w-[36rem] text-[1.1875rem] leading-relaxed text-gris @3xl:text-[1.3125rem]">
        Un vocal, une photo du cahier, un SMS de paiement : Kayé tient les ventes, les crédits et le stock,
        envoie les reçus à votre nom et vous dit le soir où vous en êtes.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={WHATSAPP} class="btn btn-night">Commencer sur WhatsApp</a>
        <a href="#comment" class="btn btn-ghost">Voir comment</a>
      </div>
    </div>

    <div class="relative mx-auto mt-14 flex max-w-[760px] justify-center pb-16">
      <Image src={recu} alt="" width={260} class="absolute top-16 left-[4%] hidden w-[230px] -rotate-6 rounded-md shadow-warm @3xl:block" aria-hidden="true" />
      <Image src={bilan} alt="" width={260} class="absolute top-10 right-[4%] hidden w-[230px] rotate-[5deg] rounded-md shadow-warm @3xl:block" aria-hidden="true" />
      <div class="relative z-10"><ChatDemo width={290} /></div>
    </div>
  </div>
</section>
