---
/** The share card (1200 × 630), the cover in miniature. Captured into public/og.png with:
 *   msedge --headless --hide-scrollbars --window-size=1200,630 --screenshot=public/og.png http://localhost:4321/og
 */
import "../styles/global.css";
import { Image } from "astro:assets";
import cover from "../assets/photos/commercant-telephone.jpg";
import lockup from "../assets/brand/lockup-cauri.svg";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>Kayé · carte de partage</title>
    <style>html, body { margin: 0; width: 1200px; height: 630px; overflow: hidden; }</style>
  </head>
  <body class="bg-nuit text-cauri">
    <div class="relative grid h-[630px] w-[1200px] grid-cols-[690px_510px]">
      <div class="flex flex-col justify-between p-16">
        <img src={lockup.src} alt="Kayé" width="150" height="50" class="h-12 w-auto self-start" />
        <h1 class="display-light m-0 text-[6.2rem]">Dites-le.<br /><b class="text-solaire">Kayé le note.</b></h1>
        <p class="m-0 text-[1.5rem] text-lilas">Votre cahier de boutique, dans WhatsApp.</p>
      </div>
      <div class="relative">
        <Image src={cover} alt="" width={1020} class="absolute inset-0 h-full w-full object-cover" loading="eager" />
        <div class="ribbon absolute inset-y-0 left-0 w-[30px]"></div>
      </div>
    </div>
  </body>
</html>
