{% extends "_ticket.html.j2" %}
{% block kind %}Reçu n° {{ number }}{% endblock %}
{% block doc_h %}1500{% endblock %}
{% block head_meta %}
<div class="row"><span class="doc-kind">Reçu n° {{ number }}</span><span class="label">{{ date }} · {{ time }}</span></div>
<div class="row"><span class="label">Client·e</span><strong>{{ customer }}</strong></div>
{% endblock %}
{% block body %}
<div class="lines">
  {% for line in lines %}
  <div class="line"><strong><span>{{ line.product }}</span><span>{{ line.total | fcfa }}</span></strong><span>{{ line.detail }} × {{ line.unit_price | fcfa }}</span></div>
  {% endfor %}
</div>
<div class="rule"></div>
<div class="total"><span class="label">Total</span><span class="amount display">{{ total | fcfa }} <small>FCFA</small></span></div>
<div class="ok"><span>Payé · {{ paid_method }}</span><span>{{ paid | fcfa }} FCFA</span></div>
{% if due > 0 %}
<div class="band due"><span class="label">Reste dû</span><span class="amount display">{{ due | fcfa }} FCFA</span></div>
{% endif %}
{% endblock %}
