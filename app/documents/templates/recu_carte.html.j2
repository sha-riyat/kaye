<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>Reçu n° {{ number }} · {{ shop.name }}</title>
<style>
{% include "_brand.css" %}
.doc { width: 1080px; height: 1500px; background: var(--cauri); display: flex; flex-direction: column; }
.top { background: var(--nuit); color: var(--cauri); padding: 64px 72px 56px; display: flex; flex-direction: column; gap: 40px; }
.brand { display: flex; align-items: center; gap: 22px; }
.brand .shop-logo { width: 92px; height: 92px; border-radius: 24px; font-size: 46px; flex-shrink: 0; }
.brand .name { font-size: 40px; font-weight: 700; display: block; }
.brand .meta { font-size: 18px; color: #CFC5DA; }
.ref { display: flex; justify-content: space-between; align-items: flex-end; }
.ref .number { font-size: 16px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--solaire); }
.ref .customer { font-size: 20px; color: #E6DCEB; margin-top: 8px; display: block; }
.ref .customer strong { color: var(--cauri); }
.ref .date { font-size: 18px; color: #CFC5DA; }
.main { padding: 48px 72px; display: flex; flex-direction: column; gap: 36px; flex-grow: 1; }
.kpis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.kpi { border-radius: 22px; background: var(--papier); padding: 24px; display: flex; flex-direction: column; gap: 8px; }
.kpi span { font-size: 16px; color: var(--gris); }
.kpi strong { font-family: var(--display); font-size: 38px; font-weight: 700; letter-spacing: -.02em; }
.kpi.paid span, .kpi.paid strong { color: var(--lagune); }
.kpi.due { background: var(--laterite); }
.kpi.due span, .kpi.due strong { color: var(--papier); }
.table { border-radius: 22px; background: var(--papier); padding: 12px 28px; }
.tr { display: grid; grid-template-columns: 2fr 1.4fr 1fr; gap: 12px; padding: 20px 0; border-bottom: 1px solid #E6D8BF; font-size: 20px; }
.tr:last-child { border-bottom: 0; }
.tr.th { padding: 16px 0; font-size: 15px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--gris); }
.tr .num { text-align: right; font-weight: 600; }
.tr .qty { color: var(--gris); }
.note { margin: 0; font-size: 18px; line-height: 1.5; color: var(--gris); }
.foot { margin-top: auto; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--trait); padding-top: 28px; font-size: 16px; color: var(--gris); }
.foot img { width: 150px; height: auto; }
</style>
</head>
<body>
<div class="doc">
  <div class="top">
    <div class="brand">
      <div class="shop-logo" aria-label="Logo de {{ shop.name }}">{{ shop.initial }}</div>
      <div><span class="name display">{{ shop.name }}</span><span class="meta">{{ shop.activity }} · {{ shop.address }} · {{ shop.phone }}</span></div>
    </div>
    <div class="ref">
      <div><span class="number">Reçu n° {{ number }}</span><span class="customer">Client·e : <strong>{{ customer }}</strong></span></div>
      <span class="date">{{ date_long }} · {{ time }}</span>
    </div>
  </div>
  <div class="main">
    <div class="kpis">
      <div class="kpi"><span>Total</span><strong>{{ total | fcfa }}</strong></div>
      <div class="kpi paid"><span>Payé · {{ paid_method }}</span><strong>{{ paid | fcfa }}</strong></div>
      <div class="kpi due"><span>Reste dû</span><strong>{{ due | fcfa }}</strong></div>
    </div>
    <div class="table">
      <div class="tr th"><span>Article</span><span>Quantité</span><span class="num">Montant</span></div>
      {% for line in lines %}
      <div class="tr"><strong>{{ line.product }}</strong><span class="qty">{{ line.detail }} × {{ line.unit_price | fcfa }}</span><span class="num">{{ line.total | fcfa }}</span></div>
      {% endfor %}
    </div>
    <p class="note">Montants en FCFA. Ce reçu est enregistré dans le cahier de {{ shop.name }}.</p>
    <div class="foot"><img src="{{ asset('lockup-night.svg') }}" alt="Kayé"><span>Code de vérification · {{ code }}</span></div>
  </div>
</div>
</body>
</html>
