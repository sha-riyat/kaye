# Copy to .env (never commit it), then: uv run modal secret create kaye-secrets --from-dotenv .env --force

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v26.0

# Meta models
META_MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
SPARK_OPEN_BASE_URL=
SPARK_OPEN_API_KEY=
SPARK_OPEN_MODEL=

# Storage
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kaye-media

# Abuse protection
DAILY_MESSAGE_QUOTA_PER_USER=100
GLOBAL_DAILY_MODEL_BUDGET_USD=5
